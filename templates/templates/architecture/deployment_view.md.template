## ☁️ 云架构拓扑

```mermaid
graph TB
    subgraph "Internet"
        USER[用户]
        CDN[{{CDN组件名称}}]
    end

    subgraph "{{云区域名称}}"
        subgraph "{{网络边界名称}}"
            subgraph "{{公网区域名称}}"
                ALB[{{入口负载均衡名称}}]
                NAT[{{出网组件名称}}]
            end

            subgraph "{{应用网络区域名称}}"
                subgraph "{{计算集群名称}}"
                    API[{{网关容器名称}}]
                    SVC1[{{服务A名称}}]
                    SVC2[{{服务B名称}}]
                end
            end

            subgraph "{{数据网络区域名称}}"
                DB[({{主数据库名称}})]
                CACHE[({{缓存名称}})]
            end
        end
    end

    USER --> CDN
    CDN --> ALB
    ALB --> API
    API --> SVC1
    API --> SVC2
    SVC1 --> DB
    SVC1 --> CACHE
    SVC2 --> DB
```

