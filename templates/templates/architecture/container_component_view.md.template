## 🏗️ 容器视图 (C4 Level 2)

```mermaid
C4Container
    title {{系统名称}} - Container Diagram

    Person(user, "用户", "终端用户")

    Container_Boundary(system, "{{系统名称}}") {
        Container(web, "{{前端容器名称}}", "{{前端技术栈}}", "{{前端职责}}")
        Container(api, "{{网关容器名称}}", "{{网关技术栈}}", "{{网关职责}}")
        Container(svc1, "{{服务A名称}}", "{{服务A技术栈}}", "{{服务A职责}}")
        Container(svc2, "{{服务B名称}}", "{{服务B技术栈}}", "{{服务B职责}}")
        ContainerDb(db, "{{主数据库名称}}", "{{主数据库职责}}")
        ContainerDb(cache, "{{缓存名称}}", "{{缓存职责}}")
        Container(mq, "{{消息系统名称}}", "{{消息系统职责}}")
    }

    Rel(user, web, "使用", "HTTPS")
    Rel(web, api, "调用", "HTTPS")
    Rel(api, svc1, "路由", "{{网关到服务A协议}}")
    Rel(api, svc2, "路由", "{{网关到服务B协议}}")
    Rel(svc1, db, "读写", "{{服务A到数据库协议}}")
    Rel(svc1, cache, "读写", "{{服务A到缓存协议}}")
    Rel(svc2, mq, "发布", "{{服务B到消息系统协议}}")
```

