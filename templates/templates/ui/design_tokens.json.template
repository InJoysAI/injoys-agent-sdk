{
  "$description": "{{三层 Design Token：Global → Alias → Component；数值只能来自 UI 规范，没有依据的 Token 整个删除，不要写占位值}}",
  "$extensions": {
    "context.meta": {
      "source": "{{UI 规范文档路径}}",
      "platforms": "{{目标平台}}",
      "basis": "{{Spec / Derived from PRD}}",
      "generatedAt": "{{生成时间 YYYY-MM-DD HH:mm}}",
      "generator": "Context-Agent v1.0"
    }
  },
  "global": {
    "$description": "第一层：原始值，无语义。命名与分组按规范，下面只演示结构",
    "color": {
      "{{色板名}}": {
        "{{档位}}": { "$value": "{{色值，如 #RRGGBB}}", "$type": "color" }
      }
    },
    "spacing": {
      "{{档位}}": { "$value": "{{数值 + 单位}}", "$type": "dimension" }
    },
    "radius": {
      "{{档位}}": { "$value": "{{数值 + 单位}}", "$type": "dimension" }
    }
  },
  "alias": {
    "$description": "第二层：语义 Token，引用 global。有多主题时在 $extensions.mode 里写各主题的引用；没有则删除 mode",
    "color": {
      "{{语义名，如 primary / text / surface}}": {
        "$value": "{global.color.{{色板名}}.{{档位}}}",
        "$type": "color",
        "$extensions": {
          "mode": {
            "light": "{global.color.{{色板名}}.{{档位}}}",
            "dark": "{global.color.{{色板名}}.{{档位}}}"
          }
        }
      }
    }
  },
  "component": {
    "$description": "第三层：组件级覆写，按需添加；没有依据就整层保持空对象",
    "{{组件名}}": {
      "{{属性}}": { "$value": "{alias.color.{{语义名}}}", "$type": "color" }
    }
  }
}
